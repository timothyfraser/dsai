{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Gemini, free tier",
      "options": {
        "apiKey": "{env:GOOGLE_GENERATIVE_AI_API_KEY}"
      },
      "models": {
        "gemini-flash-lite-latest": { "name": "Gemini Flash-Lite (latest)" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama, local (optional step up for a 16 GB laptop)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 1200000
      },
      "models": {
        "ministral-3:8b-32k": { "name": "Ministral 3 8B, 32k context (optional step up for a 16 GB laptop)" }
      }
    }
  },
  "agent": {
    "lean": {
      "description": "One task, one file, three commands. Reads AGENTS.md.",
      "mode": "primary",
      "model": "google/gemini-flash-lite-latest",
      "prompt": "You are a careful coding agent working on one small task. The task contract is in AGENTS.md. Follow it exactly. Use the bash tool to run commands, the read tool to read files and the edit tool to edit files. Keep replies short.",
      "tools": {
        "read": true,
        "edit": true,
        "bash": true,
        "write": false,
        "patch": false,
        "glob": false,
        "grep": false,
        "list": false,
        "webfetch": false,
        "task": false,
        "todowrite": false,
        "todoread": false,
        "skill": false,
        "question": false,
        "lsp": false,
        "websearch": false,
        "codesearch": false,
        "multiedit": false,
        "apply_patch": false,
        "batch": false,
        "execute": false
      },
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "python3 -m unittest tests.test_convert": "allow",
          "cat *": "allow",
          "git diff": "allow"
        }
      }
    }
  }
}
