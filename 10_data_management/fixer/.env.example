# Model API. Default is Google's free Gemini tier (OpenAI-compatible endpoint).
# Free key: https://aistudio.google.com/app/apikey
# The free tier may use your prompts to improve Google's products, so send only public or made-up data.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Use a model that supports tool calling (fixer_csv, fixer_parcels, fixer_pois)
LLM_MODEL=gemini-flash-lite-latest
# On your own computer instead: LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=granite4:3b

# Optional: cap output tokens (omit if requests return HTTP 400)
# FIXER_MAX_OUTPUT_TOKENS=2048

# Batched scripts — rows per chunk (one API call per chunk) and parallel chunk workers
# Applies to fixer_csv.R, fixer_parcels.R, fixer_pois.R, fixer_spatial_context.R
# ROWS_PER_BATCH=10
# FIXER_CHUNK_WORKERS=1

# fixer_spatial_context.R — optional overrides (defaults: output/parcels_enriched.csv + output/pois_enriched.csv)
# FIXER_CONTEXT_PARCELS=C:/path/to/parcels_enriched.csv
# FIXER_CONTEXT_POIS=C:/path/to/pois_enriched.csv
